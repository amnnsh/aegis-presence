# No environment variables or API keys are required by this prototype.
# NEVER place secrets in NEXT_PUBLIC_* variables: they are public browser code.

# Optional: PUBLIC base URL of the Aegis API (see backend/README.md). It is baked into the browser bundle.
# Leave it unset for the local-only build. ADMIN_TOKEN and SIGNING_KEY_B64 belong to the backend ONLY.
# NEXT_PUBLIC_API_URL=http://localhost:8000
