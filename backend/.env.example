# Copy to backend/.env (ignored by Git) and run: uvicorn app.main:create_app --factory --env-file .env
# None of these belong in the frontend. Never copy ADMIN_TOKEN or SIGNING_KEY_B64 into a NEXT_PUBLIC_* variable.

# sqlite file. Outcomes and timing events only; no images, video, or audio are ever accepted.
DB_PATH=./aegis.db

# Sessions and events older than this are deleted at startup and hourly.
RETENTION_HOURS=24

# Raw 32-byte Ed25519 seed, base64. Generate with:
#   python -c "import base64, secrets; print(base64.b64encode(secrets.token_bytes(32)).decode())"
# If empty, an ephemeral key is generated at startup (loud warning; tokens die with the process).
SIGNING_KEY_B64=

# Bearer token for /api/admin/* and /api/links. If empty, admin endpoints return 503. Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
ADMIN_TOKEN=

# Comma-separated browser origins allowed by CORS (no trailing slash).
ALLOWED_ORIGINS=http://localhost:3000

# Used to build help-desk links: {FRONTEND_ORIGIN}/verify/?s=<session id>
FRONTEND_ORIGIN=http://localhost:3000
